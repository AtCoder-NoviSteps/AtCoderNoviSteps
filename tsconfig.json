{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "types": ["$app/types", "node", "vitest/globals"] // Note: "types" is replaced (not merged) when extending tsconfig, so keep "$app/types" and add "node"
  },
  // Module paths are resolved by package.json#imports (#lib, #features), not path aliases
  //
  // If you want to overwrite includes/excludes, make sure to copy over the relevant includes/excludes
  // from the referenced tsconfig.json - TypeScript does not merge them in
  "include": [
    "src/**/*.d.ts",
    "src/*",
    "src/**/*.ts",
    "src/**/*.svelte",
    "prisma/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [".git", "node_modules"]
}
